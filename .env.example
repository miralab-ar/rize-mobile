# Vercel API (backend)
# After deploying to Vercel, use your project URL (e.g. https://rize-mobile-xxx.vercel.app)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Google OAuth (Web client ID — required for iOS and backend)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Google OAuth Android client ID (optional; required for Google sign-in on Android dev/production builds)
# Create in Google Cloud Console: Credentials → OAuth client ID → Android
# Package: com.miralab.rizemobile (and host.exp.Exponent for Expo Go if needed)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Invite links base URL (deep links / sharing)
EXPO_PUBLIC_INVITE_BASE_URL=https://rize.miralab.ar

# Backend env (Vercel dashboard → Settings → Environment Variables)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/rizemobile?retryWrites=true&w=majority
# GOOGLE_CLIENT_ID=same as EXPO_PUBLIC_GOOGLE_CLIENT_ID
# GOOGLE_ANDROID_CLIENT_ID=same as EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID (optional)
# JWT_SECRET=strong-random-secret
# APP_URL=https://your-app.vercel.app
